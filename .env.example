# "mock" (default) serves typed fixtures from src/api/mock. "live" calls the real backend.
VITE_API_MODE=mock
# Base URL of the Vayu-Swachh REST API (live mode only)
VITE_API_BASE_URL=http://localhost:8000/api/v1
# WebSocket for live AQI / fire alerts / agent status (live mode only). Polling is used if it drops.
VITE_WS_URL=ws://localhost:8000/ws/v1/stream
# How often to poll /realtime/snapshot while the socket is down (ms)
VITE_POLL_INTERVAL_MS=15000
# Mapbox public token. Without it the plume map falls back to a built-in schematic basemap.
VITE_MAPBOX_TOKEN=
