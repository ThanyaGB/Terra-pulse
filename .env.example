# Copy to .env (git-ignored). Never commit real values; production reads these from the secret manager.

# --- API (prefix VAYU_) ---
VAYU_ENV=dev                    # dev | staging | production. dev enables /v1/auth/dev-token and a development JWT secret
VAYU_JWT_SECRET=                # required unless VAYU_ENV=dev
VAYU_DATA_MODE=live             # live: NASA FIRMS + Open-Meteo; offline: recorded fixtures only
VAYU_LIVE_NDVI=false            # true reads Sentinel-2 COGs live (about a minute per cycle)
VAYU_REFRESH_MINUTES=15
VAYU_TELEPHONY_PRIMARY=twilio   # twilio | exotel
VAYU_REDIS_URL=                 # e.g. redis://localhost:6379/0 (enables Redis-backed rate limits)
VAYU_DATABASE_URL=              # e.g. postgresql+psycopg://vayu:...@localhost:5432/vayu (migrations)
VAYU_DATA_GOV_IN_KEY=           # free key from data.gov.in; enables the CPCB CAAQMS connector
VAYU_CALL_RATE_LIMIT=2          # outbound calls per parcel per window
VAYU_CALL_RATE_WINDOW_S=86400

# --- Web app (apps/web/.env.local) ---
VITE_API_MODE=live              # mock | live
VITE_API_BASE_URL=http://localhost:8010/v1
VITE_WS_URL=ws://localhost:8010/ws/live
VITE_POLL_INTERVAL_MS=15000
VITE_MAPBOX_TOKEN=              # optional; without it the policy map uses a built-in schematic basemap
