            "medium",
            "high",
            "critical"
          ]
        },
        "village_id": {
          "type": "string"
        }
      },
      "required": [
        "parcel_id",
        "score",
        "tier"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    },
    "trace_id": {
      "type": "string"
    },
    "type": {
      "const": "risk.updated"
    }
  },
  "required": [
    "event_id",
    "trace_id",
    "schema_version",
    "emitted_at",
    "type",
    "payload"
  ],
  "title": "risk.updated",
  "type": "object"
}
