{
  "components": {
    "schemas": {
      "Body_reports_photo_v1_reports_photo_post": {
        "properties": {
          "area_id": {
            "default": "anand-vihar",
            "title": "Area Id",
            "type": "string"
          },
          "category": {
            "enum": [
              "open_burning",
              "construction",
              "road_dust"
            ],
            "title": "Category",
            "type": "string"
          },
          "lat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lon": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "photo": {
            "contentMediaType": "application/octet-stream",
            "title": "Photo",
            "type": "string"
          }
        },
        "required": [
          "photo",
          "category"
        ],
        "title": "Body_reports_photo_v1_reports_photo_post",
        "type": "object"
      },
      "BookingCreate": {
        "properties": {
          "machine_type": {
            "anyOf": [
              {
                "enum": [
                  "super_seeder",
                  "baler",
                  "happy_seeder"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Overrides the parcel's usual machine need",
            "title": "Machine Type"
          },
          "machinery_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "SS-08"
            ],
            "title": "Machinery Id"
          },
          "parcel_id": {
            "examples": [
              "PCL-SGR-0412"
            ],
            "title": "Parcel Id",
            "type": "string"
          }
        },
        "required": [
          "parcel_id"
        ],
        "title": "BookingCreate",
        "type": "object"
      },
      "CollectionCreate": {
        "properties": {
          "parcel_id": {
            "title": "Parcel Id",
            "type": "string"
          }
        },
        "required": [
          "parcel_id"
        ],
        "title": "CollectionCreate",
        "type": "object"
      },
      "DevToken": {
        "properties": {
          "role": {
            "enum": [
              "policy_officer",
              "fpo_coordinator",
              "farmer",
              "citizen",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "sub": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sub"
          }
        },
        "required": [
          "role"
        ],
        "title": "DevToken",
        "type": "object"
      },
      "DirectiveCreate": {
        "properties": {
          "area_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Area Ids",
            "type": "array"
          },
          "type": {
            "enum": [
              "grap_ii",
              "diversion_trucks",
              "fog_cannons"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "DirectiveCreate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Keypress": {
        "properties": {
          "key": {
            "enum": [
              "1",
              "2",
              "9"
            ],
            "title": "Key",
            "type": "string"
          },
          "parcel_id": {
            "title": "Parcel Id",
            "type": "string"
          }
        },
        "required": [
          "parcel_id",
          "key"
        ],
        "title": "Keypress",
        "type": "object"
      },
      "Receipt": {
        "properties": {
          "tonnes": {
            "exclusiveMinimum": 0.0,
            "title": "Tonnes",
            "type": "number"
          }
        },
        "required": [
          "tonnes"
        ],
        "title": "Receipt",
        "type": "object"
      },
      "TriggerCall": {
        "properties": {
          "lang": {
            "default": "pa",
            "enum": [
              "pa",
              "hi",
              "en"
            ],
            "title": "Lang",
            "type": "string"
          },
          "parcel_id": {
            "title": "Parcel Id",
            "type": "string"
          }
        },
        "required": [
          "parcel_id"
        ],
        "title": "TriggerCall",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
